+// Harrington mod, 2026 - Michael Hugh Harrington
+RefineMixer::RefineMixer(const Shared* sh) : shared(sh), w(NSETS * NIN), t1(NSETS), t2(1 << 16) {
+  for (int i = 0; i < NSETS; i++) {
+    int32_t* wi = &w[i * NIN];
+    wi[0] = 0; wi[1] = 1 << 15; wi[2] = 1 << 15; wi[3] = 0; wi[4] = 0; wi[5] = 0;
+    t1[i] = 2048u << 20;
+  }
+  for (int i = 0; i < (1 << 16); i++)
+    t2[i] = 2048u << 20;
+}
+
+void RefineMixer::tupd(uint32_t& v, int y, int limit) {
+  int n = static_cast<int>(v & 1023);
+  int p = static_cast<int>(v >> 10); // 22 bits
+  const int target = (y << 22) - y;
+  p += static_cast<int>((static_cast<int64_t>(target - p) * 2) / (2 * n + 3));
+  if (n < limit) n++;
+  v = static_cast<uint32_t>(p) << 10 | static_cast<uint32_t>(n);
+}
+
+int RefineMixer::p(int prOrig, int prA, int prB) {
+  INJECT_SHARED_c0
+  INJECT_SHARED_bpos
+  INJECT_SHARED_c4
+  if (bpos == 0) {
+    const uint8_t o = lastExpected >= 256 ? 0 : (lastExpected == (c4 & 0xff) ? 1 : 2);
+    hist = static_cast<uint8_t>((hist % 3) * 3 + o);
+    lastExpected = shared->State.Match.expectedByte;
+  }
+  uint32_t mode5 = shared->State.Match.mode5;
+  if (mode5 > 19) mode5 = 19;
+  sel = static_cast<int>((mode5 * 9 + hist) * 8 + bpos);
+  const uint32_t eb = shared->State.Match.expectedByte;
+  idx2 = static_cast<int>(finalize64(hash(c4 & 0xffff, eb, c0), 16));
+  x[0] = stretch(prOrig);
+  x[1] = stretch(prA);
+  x[2] = stretch(prB);
+  x[3] = stretch(tp(t1[sel]));
+  x[4] = stretch(tp(t2[idx2]));
+  x[5] = 256;
+  const int32_t* wi = &w[sel * NIN];
+  int64_t dot = 0;
+  for (int i = 0; i < NIN; i++)
+    dot += static_cast<int64_t>(wi[i]) * x[i];
+  int d = static_cast<int>(dot >> 16);
+  if (d < -2047) d = -2047;
+  if (d > 2047) d = 2047;
+  pr = squash(d);
+  shared->GetUpdateBroadcaster()->subscribe(this);
+  return pr;
+}
+
+void RefineMixer::update() {
+  INJECT_SHARED_y
+  const int err = ((y << 12) - pr) * 6;
+  int32_t* wi = &w[sel * NIN];
+  for (int i = 0; i < NIN; i++)
+    wi[i] += (x[i] * err) >> 16;
+  tupd(t1[sel], y, 1023);
+  tupd(t2[idx2], y, 255);
+}
