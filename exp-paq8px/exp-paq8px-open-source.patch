+  if( bpos == 0 ) {
+    INJECT_SHARED_c1
+    uint32_t cls;
+    if( c1 == SPACE || c1 == TAB ) cls = 0;
+    else if( c1 == NEW_LINE || c1 == CARRIAGE_RETURN ) cls = 1;
+    else if( c1 >= '0' && c1 <= '9' ) cls = 2;
+    else if((c1 >= 'a' && c1 <= 'z') || (c1 >= 'A' && c1 <= 'Z') || c1 >= 128 ) cls = 3;
+    else if( c1 < 32 ) cls = 4;
+    else cls = 5;
+    const uint32_t lineLen = Info.prevNewLine - Info.lastNewLine;
+    if( Info.lastNewLine > 127 || lineLen > 255 || Info.lastDigit < Info.lastLetter ) {
+      cmLine.skip(CM_USE_RUN_STATS | CM_USE_BYTE_HISTORY);
+    } else {
+      cmLine.set(CM_USE_RUN_STATS | CM_USE_BYTE_HISTORY, hash(0x4C494E45, Info.lastNewLine, min(15, Info.wordLength[0]), cls));
