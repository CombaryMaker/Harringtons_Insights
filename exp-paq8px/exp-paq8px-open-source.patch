+// Harrington mod, 2026 - Michael Hugh Harrington. Mode Context (CC0 1.0): line kind from its first byte.
+uint8_t TextModel::modeKind(const uint8_t c) {
+  if( c >= 'a' && c <= 'z' ) return 1;
+  if( c >= 'A' && c <= 'Z' ) return 2;
+  if( c >= '0' && c <= '9' ) return 3;
+  if( c == QUOTE || c == APOSTROPHE || c == '`' ) return 4;
+  if( c == '=' ) return 5;
+  if( c == '*' || c == '-' || c == '#' || c == '+' ) return 6;
+  if( c == '{' || c == '|' || c == '}' ) return 7;
+  if( c == '[' || c == ']' ) return 8;
+  if( c == '<' ) return 9;
+  if( c == '(' || c == ')' ) return 10;
+  if( c >= 128 ) return 11;
+  if( c < 32 ) return 12;
+  if( c == '.' || c == ',' || c == ';' || c == ':' || c == '!' || c == '?' ) return 13;
+  return 14;
