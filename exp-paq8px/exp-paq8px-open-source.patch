+// Refinement mixer: a small secondary mixer on the final probability.
+// Inputs: stretch of model/SSE probabilities, a table keyed by match state + last 2 candidate outcomes,
+// a table keyed by order-2 context + candidate byte, and a bias. One weight set per cell of the first table.
+class RefineMixer : IPredictor {
+private:
+  const Shared* const shared;
+  static constexpr int NIN = 6;
+  static constexpr int NSETS = 20 * 9 * 8;
+  Array<int32_t> w;
