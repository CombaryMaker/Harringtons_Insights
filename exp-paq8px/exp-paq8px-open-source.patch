+  int sel = 0, idx2 = 0, pr = 2048;
+  uint16_t lastExpected = 256;
+  uint8_t hist = 0; // two trits: 0 = no candidate, 1 = hit, 2 = miss
+  static int tp(uint32_t v) { return static_cast<int>(v >> 20); }
+  static void tupd(uint32_t& v, int y, int limit);
+public:
+  RefineMixer(const Shared* sh);
+  int p(int prOrig, int prA, int prB);
+  void update() override;
+};
