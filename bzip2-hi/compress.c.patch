+static
+void sendMTFValues ( EState* s )
+{
+   /* dry runs write into the output buffer and are then rolled back */
+   UInt32 b0 = s->bsBuff; Int32 l0 = s->bsLive, z0 = s->numZ;
+   Int32 g, it, ml, iv, bestG = 0, bestI = BZ_N_ITERS, bestM = 17, bestV = 0;
+   long long best = -1;
+   static const Int32 iters[] = { 4, 8, 16, 32 };
+   static const Int32 mls[] = { 17, 20 };
+   for (g = 2; g <= 6; g++)
+    for (it = 0; it < 4; it++)
+     for (ml = 0; ml < 2; ml++)
+      for (iv = 0; iv < 3; iv++) {
+         Int32 vb = s->verbosity; s->verbosity = 0;
+         sendMTFValues_p ( s, g, iters[it], mls[ml], iv );
+         s->verbosity = vb;
+         long long bits = (long long)(s->numZ - z0) * 8 + s->bsLive - l0;
+         if (best < 0 || bits < best) { best = bits; bestG = g; bestI = iters[it]; bestM = mls[ml]; bestV = iv; }
+         s->bsBuff = b0; s->bsLive = l0; s->numZ = z0;
+      }
+   sendMTFValues_p ( s, bestG, bestI, bestM, bestV );
+}
